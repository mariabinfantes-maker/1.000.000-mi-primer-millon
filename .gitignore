# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Atlas Researcher: borradores pendientes de revisión y sus informes — estado de
# trabajo local, no forma parte del catálogo hasta que se promueve explícitamente.
/data/borradores/

# Informes HTML generados por los agentes (Affiliate Manager, Mantenimiento,
# Curator): salida de solo lectura para revisión humana, se regenera bajo demanda.
/data/informes-afiliacion/
/data/informes-mantenimiento/
/data/informes-curador/

# Copias de seguridad de la estrategia de afiliación descargadas de Neon:
# artefactos locales con datos internos, nunca se suben al repositorio.
/copias-seguridad-afiliacion/

# Resultados de las pruebas con navegador (trazas, capturas): son de una
# ejecución concreta, no del proyecto.
/test-results/
/playwright-report/

# Salida cruda de la verificación de F2: se genera en el ordenador de la
# propietaria y se entrega aparte. No es fuente, es material de trabajo.
data/verificacion/salida/

# Checkpoint y salida cruda de repescar-remoto.ts (ejecución de rescate del
# lote 1 desde el entorno de Claude): material de trabajo de una sola vez,
# no una fuente que deba persistir en el repositorio.
data/verificacion/_checkpoint-repesca-remota.json
data/verificacion/_salida-repesca-remota.json
data/verificacion/_descartes-originales.json
