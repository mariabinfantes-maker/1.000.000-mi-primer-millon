# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Atlas Researcher: borradores pendientes de revisión y sus informes — estado de
# trabajo local, no forma parte del catálogo hasta que se promueve explícitamente.
/data/borradores/

# Informes HTML generados por los agentes (Affiliate Manager, Mantenimiento,
# Curator): salida de solo lectura para revisión humana, se regenera bajo demanda.
/data/informes-afiliacion/
/data/informes-mantenimiento/
/data/informes-curador/

# Copias de seguridad de la estrategia de afiliación descargadas de Neon:
# artefactos locales con datos internos, nunca se suben al repositorio.
/copias-seguridad-afiliacion/
